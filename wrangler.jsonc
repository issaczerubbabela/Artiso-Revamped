// Cloudflare Workers deploy of the static web app (docs/deployment.md).
// Workers Builds runs `npx wrangler deploy` from the repo root; without this
// file Wrangler tries to auto-detect a framework and refuses to in a monorepo.
// No Worker script: the static export is served as assets only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "artiso",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/web/out",
    // One-page app: unknown paths serve index.html (the service worker does the
    // same offline).
    "not_found_handling": "single-page-application",
  },
}
